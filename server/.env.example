PORT=5000
NODE_ENV=development

# Railway Database Configuration
DB_HOST=shuttle.proxy.rlwy.net
DB_PORT=21840
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ecommerce_mascotas

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_here

# Email (Gmail - usar App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_aqui

# WhatsApp via Twilio
# 1. Crear cuenta en twilio.com (gratis)
# 2. Activar sandbox: console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# 3. Desde el sandbox, el cliente debe enviar el codigo de activacion UNA vez
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# (cuando tengas numero aprobado, cambiar por: whatsapp:+549XXXXXXXXXX)
